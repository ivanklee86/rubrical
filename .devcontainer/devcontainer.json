{
   "customizations": {
      "vscode": {
         "extensions": [
            "anthropic.claude-code",
            "astral-sh.ty",
            "charliermarsh.ruff",
            "github.vscode-github-actions",
            "GitHub.copilot",
            "ms-python.python",
            "ms-python.debugpy",
            "ms-python.vscode-pylance",
            "ms-azuretools.vscode-docker",
            "redhat.vscode-yaml",
            "tamasfe.even-better-toml",
            "task.vscode-task"
         ],
         "settings": {
            "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
            "python.testing.pytestArgs": [
               "tests"
            ],
            "python.testing.pytestEnabled": true,
            "python.testing.unittestEnabled": false,
            "python.venvPath": "${workspaceFolder}/.venv",
            "remote.sshAgentForwarding": true,
            "yaml.schemas": {
               "https://taskfile.dev/schema.json": [
                  "**/Taskfile.yml",
                  "**/Taskfile.yaml",
                  "tasks/**"
               ]
            }
         }
      }
   },
   "features": {
      "ghcr.io/devcontainers/features/docker-in-docker:4": {
         "moby": false
      }
   },
   "image": "ghcr.io/ivanklee86/devcontainer/python:3.14",
   "mounts": [
      "source=${localEnv:HOME}/.gitconfig,target=/home/vscode/.gitconfig,type=bind,consistency=cached",
      "source=${localEnv:HOME}/.claude,target=/home/vscode/.claude,type=bind,consistency=cached",
      "source=${localEnv:HOME}/.ssh/known_hosts,target=/home/vscode/.ssh/known_hosts,type=bind,consistency=cached,readonly"
   ],
   "name": "rubrical",
   "postCreateCommand": {
      "install-prek": "prek install && prek run",
      "rubrical-post-install": "bash ./.devcontainer/post_install.sh"
   },
   "remoteUser": "vscode"
}
